---
import "@fontsource-variable/onest";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Desarrollador web profesional con experiencia en Paraguay. Visita mi portafolio para ver mi trabajo y habilidades."
    />
    <meta name="author" content="Juan Bellenzier" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content="Juan Bellenzier" />
    <meta property="og:description" content="Portafolio - Juan Bellenzier" />
    <meta property="og:image" content="/images/jb.jpg" />
    <meta property="og:url" content="https://www.juanbellenzier.dev" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Juan Bellenzier" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Juan Bellenzier" />
    <meta name="twitter:description" content="Portafolio - Juan Bellenzier" />
    <meta name="twitter:image" content="/images/jb.jpg" />
    <meta name="twitter:site" content="@juanbellenzier" />
    <meta name="twitter:creator" content="@juanbellenzier" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.juanbellenzier.dev" />

   <!-- Favicon -->
   <link rel="icon" type="image/png" href="/favicon.png" sizes="48x48" />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Juan Bellenzier",
        "url": "https://www.juanbellenzier.dev",
        "image": "https://www.juanbellenzier.dev/images/jb.jpg",
        "sameAs": [
          "https://twitter.com/juanbellenzier",
          "https://www.linkedin.com/in/juanbellenzier/",
          "https://www.instagram.com/jbellenzier/"
        ],
        "jobTitle": "Desarrollador Web",
        "description": "Desarrollador web profesional con experiencia en Paraguay. Visita mi portafolio para ver mi trabajo y habilidades."
      }
    </script>

    <!-- Title -->
    <title>{title}</title>

    <ViewTransitions />

    <title>{title}</title>
  </head>
  <body class="relative dark:text-white">
    <div class="relative h-full w-full bg-neutral-900">
      <div
        class="absolute inset-0 bg-fuchsia-400 bg-[size:20px_20px] opacity-20 blur-[100px]"
      >
      </div>
    </div>
    <Header />
    <slot />
    <Footer />
    <script src="flowbite/dist/flowbite.min.js"></script>
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overscroll-behavior: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  @media (prefers-color-scheme: dark) {
    body {
      color: rgba(255, 255, 255, 0.9);
    }
  }
</style>
